    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero" type="Integer" array="False" size=""/>
            <output expression="&quot;digita um numero&quot;" newline="True"/>
            <input variable="numero"/>
            <if expression="numero % 2 = 0">
                <then>
                    <output expression="&quot;esse numero &#233; par&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;esse numero &#233; impar&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
