    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Altura" type="Real" array="False" size=""/>
            <output expression="&quot;qual a sua altura?&quot;" newline="True"/>
            <input variable="Altura"/>
            <if expression="Altura&gt;1.40">
                <then>
                    <output expression="&quot;voc&#234; tem altura suficiente , pode entrar no brinquedo&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;altura insuficiente voc&#234; n&#227;o pode entrar no brinquedo&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
