    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="senhaUm, senhaDois" type="String" array="False" size=""/>
            <output expression="&quot;insira a senha cadastrada&quot;" newline="True"/>
            <input variable="senhaUm"/>
            <output expression="&quot;insira sua senha novamente&quot;" newline="True"/>
            <input variable="senhaDois"/>
            <if expression="senhaUm==senhaDois">
                <then>
                    <output expression="&quot;Acesso permitido.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Senha incorreta.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
